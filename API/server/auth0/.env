# Server Configuration
PORT=3000
NODE_ENV=development

# Security
TOKEN_SECRET=use-a-strong-512bit-key-generated-with-crypto
JWT_EXPIRATION=3600
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Domain Configuration
API_DOMAIN=api.smartnhealthyhouse.com
AUTH_DOMAIN=auth.smartnhealthyhouse.com
ALLOWED_ORIGINS=http://localhost:3000,https://smartnhealthyhouse.com,https://developers.smartnhealthyhouse.com

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# Cache Configuration
CACHE_TTL=3600000
CACHE_CHECK_PERIOD=600000

# Developer Platform
DEV_PLATFORM_URL=https://developers.smartnhealthyhouse.com
DEV_REGISTER_CALLBACK=https://developers.smartnhealthyhouse.com/dashboard