{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": []
  },
  "exclude": ["node_modules"],
  "include": [
    "API/server/domain/**/*.js",
    "API/server/validate.js",
    "API/server/log.js",
    "API/server/metrics.js",
    "API/server/http.js"
  ]
}
